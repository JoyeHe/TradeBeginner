#!/usr/bin/env python3
"""Integrated test CLI for TradeBeginner.

Non-interactive, automation-friendly wrapper around pytest.
Defaults to Docker mode so it works even when local pytest is unavailable.
"""

from __future__ import annotations

import argparse
import os
import shlex
import subprocess
import sys
from pathlib import Path


PROFILE_ARGS = {
    "quick": ["tests", "-m", "not slow and not integration"],
    "unit": ["tests", "-m", "unit"],
    "safety": ["tests", "-m", "safety"],
    "full": ["tests"],
    "integration": ["tests/test_integration.py"],
    "prompt0": ["tests/test_settings.py", "tests/test_schemas.py"],
    "prompt1": [
        "tests/test_memory_working.py",
        "tests/test_memory_perceptual.py",
        "tests/test_memory_episodic.py",
        "tests/test_memory_semantic.py",
        "tests/test_memory_manager.py",
    ],
    "prompt2": ["tests/test_agent1_news.py"],
    "prompt3": ["tests/test_agent2_market.py"],
    "prompt4": ["tests/test_agent3_strategy.py"],
    "prompt5": ["tests/test_agent6_backtest.py"],
    "prompt6": ["tests/test_risk_controller.py"],
    "prompt7": ["tests/test_agent4_executor.py"],
    "prompt8": ["tests/test_agent5_behavior.py"],
    "prompt9": ["tests/test_pipeline.py", "tests/test_api.py"],
    "prompt10": ["tests/test_integration.py"],
    "prompt11": ["tests/test_settings.py", "--report"],
}


def _project_root() -> Path:
    return Path(__file__).resolve().parent


def _build_pytest_args(args: argparse.Namespace) -> list[str]:
    pytest_args = ["pytest", "-q"]
    pytest_args.extend(PROFILE_ARGS[args.profile])
    if args.report and "--report" not in pytest_args:
        pytest_args.append("--report")
    if args.tb:
        pytest_args.extend(["--tb", args.tb])
    if args.maxfail is not None:
        pytest_args.extend(["--maxfail", str(args.maxfail)])
    if args.kexpr:
        pytest_args.extend(["-k", args.kexpr])
    if args.markers:
        pytest_args.extend(["-m", args.markers])
    if args.extra:
        pytest_args.extend(args.extra)
    return pytest_args


def _run(cmd: list[str], cwd: Path, dry_run: bool) -> int:
    printable = " ".join(shlex.quote(x) for x in cmd)
    print(f"$ {printable}")
    if dry_run:
        return 0
    proc = subprocess.run(cmd, cwd=str(cwd), check=False)
    return proc.returncode


def _docker_cmd(pytest_args: list[str], cwd: Path) -> list[str]:
    return [
        "docker",
        "compose",
        "run",
        "--rm",
        "-v",
        f"{cwd}:/app",
        "app",
        *pytest_args,
    ]


def _local_cmd(pytest_args: list[str]) -> list[str]:
    return pytest_args


def cmd_profiles(_: argparse.Namespace) -> int:
    print("Available profiles:")
    for name in PROFILE_ARGS:
        print(f"  - {name}")
    return 0


def cmd_run(args: argparse.Namespace) -> int:
    cwd = _project_root()
    pytest_args = _build_pytest_args(args)
    cmd = _docker_cmd(pytest_args, cwd) if args.docker else _local_cmd(pytest_args)
    return _run(cmd, cwd=cwd, dry_run=args.dry_run)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="testbench",
        description="Integrated CLI for TradeBeginner tests.",
        epilog=(
            "Examples:\n"
            "  testbench run --profile full --report\n"
            "  testbench run --profile prompt3 --docker\n"
            "  testbench run --profile quick --markers \"not slow\" --tb short\n"
            "  testbench profiles\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_profiles = sub.add_parser("profiles", help="List available run profiles.")
    p_profiles.set_defaults(func=cmd_profiles)

    p_run = sub.add_parser("run", help="Run tests using a profile.")
    p_run.add_argument(
        "--profile",
        choices=sorted(PROFILE_ARGS.keys()),
        default="quick",
        help="Predefined test scope to run (default: quick).",
    )
    p_run.add_argument("--report", action="store_true", help="Enable structured benchmark summary output.")
    p_run.add_argument("--tb", choices=["short", "long", "line", "no", "auto"], default="short", help="Pytest traceback style.")
    p_run.add_argument("--maxfail", type=int, default=None, help="Stop after N failures.")
    p_run.add_argument("-k", dest="kexpr", default=None, help="Pytest -k expression filter.")
    p_run.add_argument("-m", dest="markers", default=None, help="Pytest marker expression override.")
    mode = p_run.add_mutually_exclusive_group()
    mode.add_argument("--docker", action="store_true", default=True, help="Run tests in docker compose app service (default).")
    mode.add_argument("--local", dest="docker", action="store_false", help="Run tests in local Python environment.")
    p_run.add_argument("--dry-run", action="store_true", help="Print command without executing.")
    p_run.add_argument("extra", nargs=argparse.REMAINDER, help="Extra pytest args passed through as-is.")
    p_run.set_defaults(func=cmd_run)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
